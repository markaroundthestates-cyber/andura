{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid",
        "fcmTokens": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "notificationPrefs": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "friendRequests": {
      "$emailKey": {
        ".read": "auth !== null && auth.token.email.toLowerCase().replace('.', ',') === $emailKey",
        "$fromUid": {
          ".read": "auth !== null && auth.uid === $fromUid",
          ".write": "auth !== null && (auth.uid === $fromUid || auth.token.email.toLowerCase().replace('.', ',') === $emailKey)",
          ".validate": "newData.hasChildren(['name', 'ts']) && newData.child('name').isString() && newData.child('name').val().length <= 40"
        }
      }
    },
    "partnerInbox": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        "$msgId": {
          ".write": "auth !== null && (auth.uid === $uid || (!data.exists() && newData.child('from').val() === auth.uid && (root.child('users').child($uid).child('partners').child(auth.uid).exists() || (newData.child('type').val() === 'accept' && root.child('friendRequests').child(auth.token.email.toLowerCase().replace('.', ',')).child($uid).exists()))))",
          ".validate": "newData.hasChildren(['type', 'from', 'ts'])"
        }
      }
    }
  }
}
